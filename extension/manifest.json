{
  "manifest_version": 3,
  "name": "Universal Downloader",
  "version": "1.3.1",
  "description": "Send video, audio, image, and post links to your local yt-dlp + FFmpeg engine.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "notifications", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:8756/*", "http://localhost:8756/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Download" }
}
